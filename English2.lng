item.game:tennis.name = Tennis
item.game:throw.desc = As far as you can, and not one step further.
item.game:throw.name = The Throw
item.game:tightrope.desc = Keep your balance, one small correction at a time.
item.game:tightrope.name = Tightrope
item.game:tincan.desc = The cans rattle. Hit the one that rattles differently.
