item.game:switchboard.name = Switchboard
item.game:syncopate.desc = Play between the beats, not on them.
item.game:syncopate.name = Off Beat
item.game:tanks.desc = Turn the turret to the rumble, fire, and dodge the shells.
item.game:tanks.name = Tank Battle
