item.mode:gauntlet.name = Gauntlet
item.mode:hardcore.desc = Everything faster. Double coins.
item.mode:hardcore.name = Hardcore Mode
item.mode:marathon.desc = One life across five random games.
item.mode:marathon.name = Marathon Mode
item.mode:mirror.desc = Every game with left and right reversed.
