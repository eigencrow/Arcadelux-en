item.game:trees.name = Tree Scout
item.game:truefalse.desc = Is the sum right? Quick!
item.game:truefalse.name = True or False
item.game:tube.desc = Ride the rim, fire down the tube.
item.game:tube.name = Tempest Tube
item.game:tuner.desc = Find the station in the static.
item.game:tuner.name = Radio Tuner
item.game:tuning.desc = Bring the note into tune.
item.game:tuning.name = Tuning Fork
item.game:valves.desc = Spin the wheels shut before the pipes burst.
item.game:valves.name = Valve Room
