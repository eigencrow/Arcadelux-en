item.game:vault.name = Vault
item.game:videopoker.desc = Jacks or better: hold the cards you want and draw the rest.
item.game:videopoker.name = Video Poker
item.game:waiter.desc = Take the order, fetch it, bring it back.
item.game:waiter.name = Table Service
item.game:weight.desc = How heavy was that thud?
item.game:weight.name = Guess The Weight
item.game:wheel.desc = Stop the wheel on the prize.
item.game:wheel.name = Fortune Wheel
item.game:width.desc = How far apart are those two sounds?
item.game:width.name = Narrow Or Wide
