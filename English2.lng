item.game:slingshot.name = Slingshot
item.game:sneak.desc = Move only when the room is loud.
item.game:sneak.name = Sneak
item.game:sniper.desc = Aim by ear alone.
item.game:sniper.name = Echo Sniper
item.game:sokoban.desc = Push every crate onto a pad.
item.game:sokoban.name = Warehouse Shift
item.game:soundorder.desc = Learn the numbers, then name them.
item.game:soundorder.name = Sound Order
item.game:splat.desc = Free fall on eight worlds. Open the chute as late as you dare.
item.game:splat.name = Splat
item.game:spotsound.desc = Catch the one sound you were given among its lookalikes.
item.game:spotsound.name = Spot The Sound
item.game:statues.desc = Keep walking, but freeze before the flash.
item.game:statues.name = Statues
item.game:sticks.desc = Take sticks. Do not take the last one.
item.game:sticks.name = The Stick Game
item.game:stilts.desc = Left, right, left, right. Do not rush.
item.game:stilts.name = Stilt Walk
item.game:streetball.desc = One on one to twenty-one: drive, shoot, and defend.
item.game:streetball.name = Street Ball
item.game:sudoku.desc = Fill the grid so every row, column and box holds each number once.
item.game:sudoku.name = Tone Sudoku
