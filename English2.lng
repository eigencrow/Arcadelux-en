# Arcadelux language file
#
# One string per line, as   key = text
# Lines starting with # are comments and are ignored.
#
# PLACEHOLDERS. Text in braces is replaced when the line is spoken. Never
# write a key name directly: the player can remap their keys, so {action}
# might be "space" for one player and "F" for another, and only the program
# knows which.
#
#   {action}   the main action key        {confirm}  confirm and advance
#   {dirs}     all four direction keys    {back}     escape
#   {up} {down} {left} {right}            {pause}    pause
#   {help}     instructions key           {status}   status key
#
# Other placeholders are filled from context: {score} {best} {coins} {total}
# {lives} {seconds} {name} {unit} {index} {total} {short}.
#
# To translate: copy this file to your language's name, for example
# Arabic.lng, and translate the text to the RIGHT of each equals sign only.
# Leave the keys and the placeholders exactly as they are.


# ---- Key names -------------------------------------------------

key.arrows = the arrow keys
key.bad = {v0} notches are wrong.
key.down = down
key.enter = enter
key.escape = escape
key.help = F1
key.ijkl = I J K L
key.left = left
key.new = A new customer. {v0} notches.
key.out = Three keys jammed.
key.pause = P
key.right = right
key.space = space
key.status = F2
key.up = up


