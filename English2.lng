item.game:longjump.name = Long Jump
item.game:loudness.desc = Which of those was louder?
item.game:loudness.name = Loudest Wins
item.game:maketen.desc = What makes it up to ten? Then twenty, then a hundred.
item.game:maketen.name = Make Ten
item.game:marble.desc = Tilt the table, thread the holes.
item.game:marble.name = Marble Run
item.game:mathladder.desc = Every right answer is a rung up. How high can you climb?
item.game:mathladder.name = Math Ladder
