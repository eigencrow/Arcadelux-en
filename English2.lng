item.game:ladder.name = Loudness Ladder
item.game:lander.desc = Land softly, or become a crater.
item.game:lander.name = Lunar Lander
item.game:laserrun.desc = A high hum means duck, a low one means jump. Sixty beams.
item.game:laserrun.name = Laser Run
