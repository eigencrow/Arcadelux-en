item.game:dive.desc = Hold your breath. Take one more pearl.
item.game:dive.name = Pearl Dive
item.game:docking.desc = Line up and come in slow.
item.game:docking.name = Docking Bay
item.game:doors.desc = One door leads on. The rest send you back.
item.game:doors.name = Cursed Doors
item.game:doppler.desc = Is it moving towards you, or away?
item.game:doppler.name = Coming Or Going
