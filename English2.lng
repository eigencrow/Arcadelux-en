item.game:invaders.name = Space Invaders
item.game:joust.desc = Meet them high, not low.
item.game:joust.name = Joust
item.game:juggler.desc = Keep every ball in the air, catching each one as it comes down.
item.game:juggler.name = Juggler
item.game:keycutter.desc = Hear the key, then cut its twin.
item.game:keycutter.name = Key Cutter
item.game:kinema.desc = A ball thrown upward: how high, how long, how fast?
item.game:kinema.name = Kinema
item.game:kitchen.desc = Three pans, three timers, one pair of hands.
item.game:kitchen.name = Night Kitchen
item.game:knight.desc = Move a chess knight to each flag in as few jumps as you can.
item.game:knight.name = Knight's Path
