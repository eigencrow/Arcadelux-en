item.game:taxi.name = Taxi Driver
item.game:telegraph.desc = Short, long, short. Send it back.
item.game:telegraph.name = Telegraph
item.game:tempo.desc = Keep the beat after the music stops.
item.game:tempo.name = Tempo Lock
